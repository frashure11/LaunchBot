# Discord bot token — from https://discord.com/developers/applications
# (Bot tab -> Reset Token). Keep this secret; never commit the real .env.
DISCORD_TOKEN=

# Your Discord server (guild) ID. When set, slash commands sync instantly to
# just that server — best for development. Leave blank to sync globally
# instead (works on every server the bot is in, but can take up to an hour
# to show up after each change).
GUILD_ID=

# The only channel ID the bot will respond in. Commands used elsewhere are
# rejected with a "wrong channel" reply.
CHANNEL_ID=

# Where per-launch stdout/stderr logs are written.
LOG_DIR=./logs
